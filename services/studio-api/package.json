{
  "name": "@tamix/studio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de Tamix Media Studio. Lambda + DynamoDB propios; el contenido, la audiencia y los ingresos salen siempre de services/social-api en Tamix-social-media.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-scheduler": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-jwt-verify": "^4.0.1",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
